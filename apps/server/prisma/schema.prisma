generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ForecastType {
  SHORT_TERM  @map("short_term")
  MEDIUM_TERM @map("medium_term")
  LONG_TERM   @map("long_term")

  @@map("forecast_type")
}

enum PredictionDirection {
  UP      @map("up")
  DOWN    @map("down")
  NEUTRAL @map("neutral")

  @@map("prediction_direction")
}

enum RiskLevel {
  LOW    @map("low")
  MEDIUM @map("medium")
  HIGH   @map("high")

  @@map("risk_level")
}

enum ForecastStatus {
  PENDING   @map("pending")
  RUNNING   @map("running")
  COMPLETED @map("completed")
  FAILED    @map("failed")

  @@map("forecast_status")
}

enum MetricType {
  PRICE      @map("price")
  VOLUME     @map("volume")
  VOLATILITY @map("volatility")
  MOMENTUM   @map("momentum")
  SENTIMENT  @map("sentiment")
  DOWNLOADS    @map("downloads")
  LIKES        @map("likes")
  MENTIONS     @map("mentions")
  SCORE        @map("score")
  COMMENTS     @map("comments")
  ENGAGEMENT   @map("engagement")
  PUBLICATIONS @map("publications")

  @@map("metric_type")
}

enum EvaluationStatus {
  CORRECT   @map("correct")
  INCORRECT @map("incorrect")

  @@map("evaluation_status")
}

model Source {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  name      String
  baseUrl   String?  @map("base_url")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  rawRecords RawRecord[]

  @@index([isActive])
  @@map("sources")
}

model Entity {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  name        String
  symbol      String?
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rawRecords RawRecord[]
  metrics    Metric[]
  forecasts  Forecast[]

  @@index([symbol])
  @@map("entities")
}

model RawRecord {
  id         String   @id @default(uuid()) @db.Uuid
  sourceId   String   @map("source_id") @db.Uuid
  entityId   String?  @map("entity_id") @db.Uuid
  externalId String?  @map("external_id")
  checksum   String
  observedAt DateTime @map("observed_at")
  ingestedAt DateTime @default(now()) @map("ingested_at")
  payload    Json     @db.JsonB

  source Source  @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  entity Entity? @relation(fields: [entityId], references: [id], onDelete: Restrict)
  metrics Metric[]

  @@unique([sourceId, checksum])
  @@index([sourceId, observedAt])
  @@index([sourceId, externalId])
  @@index([entityId, observedAt])
  @@index([ingestedAt])
  @@map("raw_records")
}

model Metric {
  id          String     @id @default(uuid()) @db.Uuid
  entityId    String     @map("entity_id") @db.Uuid
  rawRecordId String?    @map("raw_record_id") @db.Uuid
  type        MetricType
  value       Decimal    @db.Decimal(24, 8)
  normalizedValue Decimal    @map("normalized_value") @db.Decimal(5, 2)
  unit        String?
  observedAt  DateTime   @map("observed_at")
  calculatedAt DateTime  @default(now()) @map("calculated_at")

  entity    Entity     @relation(fields: [entityId], references: [id], onDelete: Restrict)
  rawRecord RawRecord? @relation(fields: [rawRecordId], references: [id], onDelete: Restrict)
  factors   ForecastFactor[]

  @@unique([rawRecordId, type])
  @@index([entityId, type, observedAt(sort: Desc)])
  @@index([rawRecordId])
  @@index([calculatedAt])
  @@map("metrics")
}

model Forecast {
  id             String               @id @default(uuid()) @db.Uuid
  entityId       String               @map("entity_id") @db.Uuid
  forecastType   ForecastType
  score          Decimal              @db.Decimal(5, 2)
  status         ForecastStatus       @default(PENDING)
  direction      PredictionDirection?
  riskLevel      RiskLevel?           @map("risk_level")
  confidence     Decimal?             @db.Decimal(5, 2)
  risk           RiskLevel
  prediction     String
  predictedValue Decimal?             @map("predicted_value") @db.Decimal(24, 8)
  summary        String?
  failureReason  String?              @map("failure_reason")
  modelVersion   String?              @map("model_version")
  explainability Json                 @db.JsonB
  targetAt       DateTime             @map("target_at") @db.Timestamptz(3)
  createdAt      DateTime             @default(now()) @map("created_at")
  completedAt    DateTime?            @map("completed_at")

  entity  Entity             @relation(fields: [entityId], references: [id], onDelete: Restrict)
  factors ForecastFactor[]
  outcome ForecastOutcome?

  @@index([entityId, forecastType, createdAt(sort: Desc)])
  @@index([entityId, targetAt])
  @@index([status, createdAt])
  @@index([targetAt])
  @@map("forecasts")
}

model ForecastFactor {
  id              String                @id @default(uuid()) @db.Uuid
  forecastId      String                @map("forecast_id") @db.Uuid
  metricId        String?               @map("metric_id") @db.Uuid
  sourceKey       String                @map("source_key")
  metricType      MetricType            @map("metric_type")
  rawValue        Decimal               @map("raw_value") @db.Decimal(24, 8)
  normalizedValue Decimal               @map("normalized_value") @db.Decimal(5, 2)
  contribution    Decimal               @db.Decimal(7, 4)
  direction       PredictionDirection?
  weight          Decimal               @db.Decimal(7, 6)
  description     String
  position        Int
  createdAt       DateTime              @default(now()) @map("created_at")

  forecast Forecast @relation(fields: [forecastId], references: [id], onDelete: Restrict)
  metric   Metric?  @relation(fields: [metricId], references: [id], onDelete: Restrict)

  @@unique([forecastId, position])
  @@index([forecastId])
  @@index([metricId])
  @@index([sourceKey, metricType])
  @@map("forecast_factors")
}

model ForecastOutcome {
  id              String              @id @default(uuid()) @db.Uuid
  forecastId      String              @unique @map("forecast_id") @db.Uuid
  actualValue     Decimal            @map("actual_value") @db.Decimal(24, 8)
  expectedValue   Decimal             @map("expected_value") @db.Decimal(24, 8)
  status          EvaluationStatus
  evaluatedAt     DateTime            @map("evaluated_at") @db.Timestamptz(3)
  createdAt       DateTime            @default(now()) @map("created_at")

  forecast Forecast @relation(fields: [forecastId], references: [id], onDelete: Restrict)

  @@index([status, evaluatedAt])
  @@index([evaluatedAt])
  @@map("forecast_outcomes")
}